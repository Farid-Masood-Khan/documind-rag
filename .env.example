# DocuMind Environment Variables
EMBED_MODEL=all-MiniLM-L6-v2
EMBED_DIM=384
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
SIM_THRESHOLD=0.30

# LLM Configuration
# LLM_BACKEND can be 'mock' (offline deterministic test), 'ollama', or 'openai'
LLM_BACKEND=mock
LLM_MODEL=llama3:8b
LLM_API_BASE=http://localhost:11434/v1
LLM_API_KEY=

# Server Configuration
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///documind.db
DATA_DIR=data/sessions

